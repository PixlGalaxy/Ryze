# Copy this file to .env and fill it in. Never commit .env.

# Developer Portal > Bot > Reset Token
DISCORD_TOKEN=
# Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=
# Developer Portal > OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=

# Optional ---------------------------------------------------------------

# Host port for the Activity web app (docker-compose only).
# RYZE_PORT=3000

# Folder for the database and other persistent data. In Docker it is /appdata.
# DATA_DIR=./appdata

# Register slash commands only in this server (instant updates while developing).
# DEV_GUILD_ID=

# Text shown as the bot's status.
# PRESENCE_TEXT=/help · /voice

# Days of activity log to keep.
# EVENT_RETENTION_DAYS=90
